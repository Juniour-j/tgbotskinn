# Токен від @BotFather (перевипусти той, що засвітив!)
TELEGRAM_TOKEN=123456:AA...

# Шлях до файлу БД. На Railway вкажи каталог примонтованого Volume, напр. /data/bot.db
DB_PATH=bot.db

# Період перевірки цін, секунд
POLL_INTERVAL=60

# Джерело прайсу (csgo.json / dota2.json / rust.json)
LIS_EXPORT_URL=https://lis-skins.com/market_export_json/csgo.json

HTTP_TIMEOUT=30
