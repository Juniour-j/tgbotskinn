# Токен від @BotFather (перевипусти той, що засвітив!)
TELEGRAM_TOKEN=123456:AA...

# Шлях до файлу БД. На Railway вкажи каталог примонтованого Volume, напр. /data/bot.db
DB_PATH=bot.db

# Період перевірки цін, секунд
POLL_INTERVAL=60

# Джерело прайсу (csgo.json / dota2.json / rust.json)
LIS_EXPORT_URL=https://lis-skins.com/market_export_json/csgo.json

# Повний експорт — точна ціна + глибина ринку. Використовується для ВСІХ стежень
# (короткий csgo.json бреше на кейсах на кілька центів).
FULL_EXPORT_URL=https://lis-skins.com/market_export_json/api_csgo_full.json
# Як часто оновлювати, хвилин. Файл ~160 МБ gzip — менше = свіжіше, але більше трафіку.
DEPTH_REFRESH_MIN=10

HTTP_TIMEOUT=30

# Додаткові ринки для звичайного стеження за ціною (крім lis-skins).
# Доступні: mcsgo (market.csgo.com, з buy-order), skinport. Пусто = тільки lis-skins.
# Skinport з датацентрів часто 403 — тоді лиши SOURCES=mcsgo.
SOURCES=mcsgo,skinport
# MCSGO_URL=https://market.csgo.com/api/v2/prices/class_instance/USD.json
# SKINPORT_URL=https://api.skinport.com/v1/items?app_id=730&currency=USD

# Ціна зі Steam (лінива, по одному айтему, кеш 6 год). 0 — вимкнути.
STEAM_ENABLED=1

# Хто може користуватись ботом — Telegram user id через кому/пробіл.
# Дізнатися свій id: команда /whoami. Пусто = дозволено всім.
ALLOWED_USER_IDS=
