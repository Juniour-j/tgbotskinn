# Токен від @BotFather (перевипусти той, що засвітив!)
TELEGRAM_TOKEN=123456:AA...

# Шлях до файлу БД. На Railway вкажи каталог примонтованого Volume, напр. /data/bot.db
DB_PATH=bot.db

# Період перевірки цін, секунд
POLL_INTERVAL=60

# Джерело прайсу (csgo.json / dota2.json / rust.json)
LIS_EXPORT_URL=https://lis-skins.com/market_export_json/csgo.json

# Повний експорт для глибини ринку (потрібен лише стеженням з x<шт>)
FULL_EXPORT_URL=https://lis-skins.com/market_export_json/api_csgo_full.json
# Як часто оновлювати глибину, хвилин (файл ~160 МБ, тож не робіть занадто часто)
DEPTH_REFRESH_MIN=15

HTTP_TIMEOUT=30

# Хто може користуватись ботом — Telegram user id через кому/пробіл.
# Дізнатися свій id: команда /whoami. Пусто = дозволено всім.
ALLOWED_USER_IDS=
